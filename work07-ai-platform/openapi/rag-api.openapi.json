  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IndexDocRequest": {
        "properties": {
          "docId": {
            "type": "string",
            "title": "Docid"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "docId",
          "title",
          "body"
        ],
        "title": "IndexDocRequest"
      },
      "QaRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "topK": {
            "type": "integer",
            "title": "Topk",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "QaRequest"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "topK": {
            "type": "integer",
            "title": "Topk",
            "default": 5
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "hybrid"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
